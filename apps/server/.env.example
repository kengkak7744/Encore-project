DATABASE_URL=postgres://artist:artist@localhost:5432/artist_tracker
PORT=4000
WEB_ORIGIN=http://localhost:3000
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# Use the same resource ID in API and both workers sharing one GPU/database.
OLLAMA_RESOURCE_ID=encore-local-gpu
OLLAMA_BACKGROUND_QUIET_SECONDS=15
BIOGRAPHY_OLLAMA_URL=http://localhost:11434
BIOGRAPHY_MODEL=encore-biography:qwen3.8-27b
BIOGRAPHY_ENABLED=true
# Asia/Bangkok; 00:00 means midnight at the end of this night's window.
BIOGRAPHY_WINDOW_START=23:00
BIOGRAPHY_WINDOW_END=00:00
BIOGRAPHY_MAX_PER_NIGHT=10
BIOGRAPHY_TIMEOUT_SECONDS=240
X_BEARER_TOKEN=
X_MONTHLY_LIMIT_THB=350
TICKETMASTER_API_KEY=
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2
TICKETMASTER_COUNTRY_CODE=TH
TICKETMASTER_TIMEOUT_SECONDS=10
CONCERT_SCHEDULER_ENABLED=true
BANDSINTOWN_APP_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v22.0
INSTAGRAM_GRAPH_ACCESS_TOKEN=
INSTAGRAM_GRAPH_IG_USER_ID=
INSTAGRAM_GRAPH_TOKEN_EXPIRES_AT=
INSTAGRAM_GRAPH_API_VERSION=v25.0
SOCIAL_SCHEDULER_ENABLED=true
SOCIAL_SYNC_INTERVAL_MINUTES=60
SOCIAL_STALE_AFTER_MINUTES=60
# At most one due Instagram account per worker tick; new/changed posts may need a second media request.
INSTAGRAM_REQUEST_SPACING_SECONDS=60
INSTAGRAM_MEDIA_REFRESH_HOURS=6
INSTAGRAM_USAGE_PAUSE_PERCENT=75
INSTAGRAM_RATE_LIMIT_COOLDOWN_MINUTES=60
GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_TIMEOUT_SECONDS=5
# Agoda Search requires approved partner access. Use assigned endpoints/property IDs.
AGODA_ENABLED=false
AGODA_CLIENT_ID=
AGODA_CLIENT_SECRET=
AGODA_TOKEN_URL=
AGODA_SEARCH_URL=
AGODA_ENV=sandbox
AGODA_PROPERTY_IDS_JSON={}
GOOGLE_MAPS_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Personal local scraping; obtain publication permissions before a public deployment.
CONCERT_LOCAL_RESEARCH_ENABLED=false
CONCERT_REUSE_AUTHORIZED_SOURCES=
CONCERT_DETAIL_LIMIT=200
CONCERT_REPORT_DIRECTORY=.local/concert-reports
